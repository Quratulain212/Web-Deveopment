//App.jsx
import { useState } from "react";
import "./App.css";

import toolImg from "./assets/tool.jpg";
import portfolioImg from "./assets/portfolio.jpg";
import landingImg from "./assets/landing.jpg";

function App() {
  const [dark, setDark] = useState(false);

  const scrollToSection = (id) => {
    const section = document.getElementById(id);
    if (section) {
      section.scrollIntoView({ behavior: "smooth" });
    }
  };

  return (
    <div className={dark ? "app dark" : "app"}>

      <header className="navbar">
        <h2 className="logo">Portfolio</h2>

        <nav>
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </nav>

        <button onClick={() => setDark(!dark)} className="mode-btn">
          {dark ? "Light" : "Dark"}
        </button>
      </header>

      <section className="hero">
        <h1>Frontend Developer & Designer</h1>
        <p>
          I build modern, responsive and user-friendly web applications
          using React and modern technologies.
        </p>

        <button onClick={() => scrollToSection("projects")}>
          View My Work
        </button>
      </section>

      <section id="about" className="section">
        <h2>About Me</h2>
        <p>
          Passionate web developer focused on building clean UI,
          scalable applications, and interactive experiences.
        </p>
      </section>

      <section id="projects" className="cards">
        <div className="card">
          <h3>Tools List Manager (React + Vite)</h3>
          <img src={toolImg} alt="Tool" />
          <p>
            Tool management application with dark mode,
            component-based structure, and responsive layout.
          </p>
          <button onClick={() => alert("Opening Tools List App")}>
            View Project
          </button>
        </div>

        <div className="card">
          <h3>Responsive Portfolio Website</h3>
          <img src={portfolioImg} alt="Portfolio" />
          <p>
            Personal portfolio featuring modern design,
            mobile-first responsiveness, and interactive UI.
          </p>
          <button onClick={() => alert("Opening Portfolio Website")}>
            View Project
          </button>
        </div>

        <div className="card">
          <h3>Business Landing Page UI</h3>
          <img src={landingImg} alt="Landing" />
          <p>
            Professional landing page with hero section,
            feature highlights, and clean UX structure.
          </p>
          <button onClick={() => alert("Opening Landing Page")}>
            View Project
          </button>
        </div>
      </section>

       <section id="contact" className="section">
        <h2>Contact</h2>
        <p>Email: xyz@email.com</p>
      </section>

      <footer className="footer">
        <p>© 2026 Professional React Portfolio</p>
      </footer>
    </div>
  );
}

export default App;

