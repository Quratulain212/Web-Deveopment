//.html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Password Generator</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="task9.css">
</head>

<body class="bg-gray-200 flex items-center justify-center min-h-screen">

<div class="bg-white w-[420px] p-6 rounded-xl shadow-xl">

  <h2 class="text-xl font-semibold mb-4 text-center">
    Password Generator
  </h2>

  <div class="flex mb-4">
    <input id="result" type="text" readonly
      class="flex-1 p-3 rounded-l bg-gray-100 font-mono border border-gray-300">
    <button id="copyBtn"
      class="bg-green-500 hover:bg-green-600 text-white px-4 rounded-r">
      Copy
    </button>
  </div>

  <div class="strength-container">
    <div id="bar" class="strength-bar"></div>
  </div>

  <div class="mb-4">
    <label class="text-sm">
      Length: <span id="lenValue">12</span>
    </label>
    <input type="range" min="4" max="32" value="12"
      id="length" class="w-full">
  </div>

  <div class="space-y-2 mb-4">
    <label><input type="checkbox" id="upper" checked> Uppercase</label><br>
    <label><input type="checkbox" id="lower" checked> Lowercase</label><br>
    <label><input type="checkbox" id="number" checked> Numbers</label><br>
    <label><input type="checkbox" id="symbol"> Symbols</label>
  </div>

  <button id="generateBtn"
    class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg">
    Generate Password
  </button>

</div>

<script src="script.js"></script>
</body>
</html>

//.css
body {
  font-family: Arial, sans-serif;
}

.strength-container {
  width: 100%;
  height: 8px;
  background: #ddd;
  border-radius: 5px;
  margin-bottom: 15px;
}

.strength-bar {
  height: 8px;
  width: 0%;
  border-radius: 5px;
  transition: 0.3s ease;
}

.weak {
  background: #ef4444;
  width: 25%;
}

.medium {
  background: #facc15;
  width: 50%;
}

.good {
  background: #3b82f6;
  width: 75%;
}

.strong {
  background: #22c55e;
  width: 100%;
}

//.js
document.addEventListener("DOMContentLoaded", function () {

  const output = document.getElementById("result");
  const slider = document.getElementById("length");
  const lenValue = document.getElementById("lenValue");
  const bar = document.getElementById("bar");
  const generateBtn = document.getElementById("generateBtn");
  const copyBtn = document.getElementById("copyBtn");

  slider.addEventListener("input", function () {
    lenValue.textContent = slider.value;
  });

  generateBtn.addEventListener("click", generatePassword);
  copyBtn.addEventListener("click", copyPassword);

  function generatePassword() {
    const length = parseInt(slider.value);
    let characters = "";

    if (document.getElementById("upper").checked)
      characters += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    if (document.getElementById("lower").checked)
      characters += "abcdefghijklmnopqrstuvwxyz";

    if (document.getElementById("number").checked)
      characters += "0123456789";

    if (document.getElementById("symbol").checked)
      characters += "!@#$%^&*()_+{}[]<>?/";

    if (characters === "") {
      alert("Please select at least one option");
      return;
    }

    let password = "";

    for (let i = 0; i < length; i++) {
      const randomIndex = Math.floor(Math.random() * characters.length);
      password += characters[randomIndex];
    }

    output.value = password;
    updateStrength(password);
  }

  function updateStrength(password) {
    let score = 0;

    if (password.length >= 12) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[0-9]/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    bar.className = "strength-bar";

    if (score <= 1) {
      bar.classList.add("weak");
    } 
    else if (score === 2) {
      bar.classList.add("medium");
    } 
    else if (score === 3) {
      bar.classList.add("good");
    } 
    else {
      bar.classList.add("strong");
    }
  }

  function copyPassword() {
    if (output.value !== "") {
      navigator.clipboard.writeText(output.value);
      alert("Password copied!");
    }
  }

  generatePassword();

});
