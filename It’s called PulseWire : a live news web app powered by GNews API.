//.html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Global News Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="task10.css">
</head>
<body>

<header class="hero">
    <div class="hero-content">
        <h1>Global News Portal</h1>
        <p>Live news powered by GNews API</p>

        <div class="search-bar">
            <input type="text" id="searchInput" placeholder="Search news...">
            <button id="searchBtn">Search</button>
        </div>

        <div class="categories">
            <button class="categoryBtn" data-category="sports">Sports</button>
            <button class="categoryBtn" data-category="technology">Technology</button>
            <button class="categoryBtn" data-category="business">Business</button>
        </div>
    </div>
</header>

<div id="loader" class="loader hidden"></div>
<p id="errorMessage" class="error hidden"></p>

<section id="newsContainer" class="news-container"></section>

<script src="task10.js"></script>
</body>
</html>

//.css
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #f8fafc;
    color: #1e293b;
}

.hero {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    padding: 60px 20px;
    text-align: center;
}

.hero h1 {
    font-size: 40px;
    font-weight: 700;
}

.hero p {
    margin: 10px 0 25px;
    opacity: 0.9;
}

.search-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
}

.search-bar input {
    padding: 10px 15px;
    width: 260px;
    border-radius: 50px;
    border: none;
    outline: none;
}

.search-bar button {
    padding: 10px 20px;
    border-radius: 50px;
    border: none;
    background: white;
    color: #2563eb;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
}

.search-bar button:hover {
    transform: scale(1.05);
}

.categories {
    margin-top: 10px;
}

.categoryBtn {
    padding: 8px 18px;
    margin: 5px;
    border-radius: 30px;
    border: 1px solid white;
    background: transparent;
    color: white;
    cursor: pointer;
    transition: 0.3s;
}

.categoryBtn:hover,
.categoryBtn.active {
    background: white;
    color: #2563eb;
}

.news-container {
    padding: 50px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
}

.article {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    transition: 0.4s;
}

.article:hover {
    transform: translateY(-10px);
}

.article img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.article-content {
    padding: 20px;
}

.article h3 {
    font-size: 18px;
    margin-bottom: 10px;
}

.article p {
    font-size: 14px;
    color: #475569;
    margin-bottom: 15px;
}

.article a {
    text-decoration: none;
    font-weight: 600;
    color: #2563eb;
}

.loader {
    border: 6px solid #e2e8f0;
    border-top: 6px solid #2563eb;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    margin: 40px auto;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    100% { transform: rotate(360deg); }
}

.hidden {
    display: none;
}

.error {
    text-align: center;
    color: red;
    margin-top: 20px;
    font-weight: 600;
}

//.js
const apiKey = "776ea04abd839d82dc6a45440f146933";
const baseURL = "https://gnews.io/api/v4";

const newsContainer = document.getElementById("newsContainer");
const loader = document.getElementById("loader");
const errorMessage = document.getElementById("errorMessage");
const searchBtn = document.getElementById("searchBtn");
const searchInput = document.getElementById("searchInput");
const categoryButtons = document.querySelectorAll(".categoryBtn");

function showLoader() {
    loader.classList.remove("hidden");
}

function hideLoader() {
    loader.classList.add("hidden");
}

function showError(message) {
    errorMessage.textContent = message;
    errorMessage.classList.remove("hidden");
}

function hideError() {
    errorMessage.classList.add("hidden");
}

function setActiveButton(clickedBtn) {
    categoryButtons.forEach(btn => btn.classList.remove("active"));
    if (clickedBtn) clickedBtn.classList.add("active");
}

function displayArticles(articles) {
    newsContainer.innerHTML = "";

    articles.forEach(article => {
        const articleDiv = document.createElement("div");
        articleDiv.classList.add("article");

        articleDiv.innerHTML = `
            <img src="${article.image || 'https://via.placeholder.com/400x200'}">
            <div class="article-content">
                <h3>${article.title}</h3>
                <p>${article.description || 'No description available.'}</p>
                <a href="${article.url}" target="_blank">Read More →</a>
            </div>
        `;

        newsContainer.appendChild(articleDiv);
    });
}

function fetchNews(query = "latest") {
    showLoader();
    hideError();
    newsContainer.innerHTML = "";

    fetch(`${baseURL}/search?q=${query}&lang=en&max=9&apikey=${apiKey}`)
        .then(res => {
            if (!res.ok) throw new Error("API failed");
            return res.json();
        })
        .then(data => {
            hideLoader();

            if (!data.articles || data.articles.length === 0) {
                showError("No articles found.");
                return;
            }

            displayArticles(data.articles);
        })
        .catch(err => {
            hideLoader();
            showError("Unable to fetch news.");
            console.error(err);
        });
}


fetchNews();

searchBtn.addEventListener("click", () => {
    const query = searchInput.value.trim();
    if (query) {
        setActiveButton(null);
        fetchNews(query);
    }
});

categoryButtons.forEach(button => {
    button.addEventListener("click", () => {
        setActiveButton(button);
        fetchNews(button.dataset.category);
    });
});
